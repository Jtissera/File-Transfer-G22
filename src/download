#!/usr/bin/env python3
import argparse
import sys
import os
import socket
import time

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "lib"))

from logger import get_logger
from rtt import (
    rtt_new,
    rtt_duplicate,
    rtt_timeout,
    rtt_update,
)
from protocol import (
    build_download_req,
    parse_packet,
    parse_error,
    parse_ack_port_and_size,
)

from constants import (
    MSG_ACK,
    MSG_ERROR,
    MAX_PACKET_SIZE,
    PROTOCOL_SW,
    PROTOCOL_GBN,
    MAX_RETRIES,
)


def parse_args():
    parser = argparse.ArgumentParser(
        prog="download",
        description="Download a file from the server.",
        formatter_class=lambda prog: argparse.HelpFormatter(
            prog,
            width=120,
            max_help_position=50,
        ),
    )

    verbosity = parser.add_mutually_exclusive_group()
    verbosity.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="increase output verbosity",
    )
    verbosity.add_argument(
        "-q", "--quiet", action="store_true", help="decrease output verbosity"
    )

    parser.add_argument(
        "-H",
        "--host",
        type=str,
        default="127.0.0.1",
        metavar="<addr>",
        help="server IP address",
    )
    parser.add_argument(
        "-p",
        "--port",
        type=int,
        default=8080,
        metavar="<port>",
        help="server port",
    )
    parser.add_argument(
        "-d",
        "--dst",
        type=str,
        required=True,
        metavar="<filepath>",
        help="destination file path",
    )
    parser.add_argument(
        "-n",
        "--name",
        type=str,
        required=True,
        metavar="<filename>",
        help="file name",
    )
    parser.add_argument(
        "-r",
        "--protocol",
        type=str,
        choices=["saw", "gbn"],
        default="saw",
        metavar="<protocol>",
        help="error recovery protocol: saw (Stop & Wait) or gbn (Go-Back-N)",
    )

    return parser.parse_args()


def main():
    args = parse_args()
    logger = get_logger("download", args.verbose, args.quiet)

    logger.debug(f"Host: {args.host}, Port: {args.port}")
    logger.debug(f"Destination: {args.dst}, Name: {args.name}")
    logger.debug(f"Protocol: {args.protocol}")
    logger.info(f'Starting download of "{args.name}" -> "{args.dst}"')

    if args.protocol == "gbn":
        protocol_id = PROTOCOL_GBN
        import go_back_n as protocol
    else:
        protocol_id = PROTOCOL_SW
        import stop_and_wait as protocol

    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    server_addr = (args.host, args.port)

    transfer_port = None
    filesize = None
    retries = 0
    rtt = rtt_new()

    while transfer_port is None:
        if retries >= MAX_RETRIES:
            logger.error("No se pudo establecer conexion con el servidor")
            sock.close()
            return

        sock.sendto(build_download_req(args.name, protocol_id), server_addr)
        send_time = time.time()

        try:
            sock.settimeout(rtt_timeout(rtt))
            data, _ = sock.recvfrom(MAX_PACKET_SIZE)
            packet = parse_packet(data)

            if packet["type"] == MSG_ERROR:
                logger.error(
                    f"Error del servidor: {parse_error(packet['payload'])}"
                )
                sock.close()
                return

            if packet["type"] == MSG_ACK and packet["ack_number"] == 0:

                transfer_port, filesize = parse_ack_port_and_size(
                    packet["payload"]
                )
                if retries == 0:
                    rtt = rtt_update(rtt, time.time() - send_time)

            else:
                logger.debug("Respuesta inesperada del servidor, reintentando")
                retries += 1

        except socket.timeout:
            retries += 1
            rtt = rtt_duplicate(rtt)
            logger.debug(
                f"Timeout esperando ACK(0), reintento {retries}/{MAX_RETRIES}"
            )

    logger.debug(
        f"Servidor listo en puerto {transfer_port}, filesize={filesize} bytes"
    )

    filepath = os.path.join(args.dst, args.name)

    try:
        protocol.receive(sock, filepath, filesize, first_seq=1, logger=logger)
    except protocol.TransferError as e:
        logger.error(f"Error en la transferencia: {e}")
        sock.close()
        return

    logger.info(f'Download de "{args.name}" completado')
    sock.close()


if __name__ == "__main__":
    main()
